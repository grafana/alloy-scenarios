faro.receiver "crawl" {
  log_format = "json"
  extra_log_labels = { service_name = "borant-broadcast" }

  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs = [loki.process.browser.receiver]
  }
}

// Use browser timestamps to order viewer actions within each Faro session.
loki.process "browser" {
  stage.json {
    expressions = { occurred = "timestamp" }
  }
  stage.timestamp {
    source = "occurred"
    format = "2006-01-02 15:04:05.999999999 -0700 MST"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
