    {
      "type": "logs",
      "title": "Quest journal · NPC interactions",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 13,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200,
          "expr": "{service_name=\"wow-journey-simulator\",service_instance_id=\"$run\"} | json | event!=\"\" | line_format \"{{.event}} · {{.who}} · {{.place}} (level {{.level}})\"",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Chapter traces · Open a trace",
      "type": "table",
      "gridPos": {
        "x": 13,
        "y": 21,
        "w": 11,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "query": "{ resource.service.name = \"wow-journey-simulator\" && span.wow.run = \"$run\" }",
          "limit": 20
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "nested": true,
              "startTime": true
            },
            "indexByName": {
              "traceName": 0,
              "traceDuration": 1,
              "traceID": 2
            }
          }
        }
      ]
    }
