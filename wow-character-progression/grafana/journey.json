{
  "uid": "tirisfal-journey",
  "title": "Tirisfal Glades · A Forsaken journey",
  "description": "Simulated Undead priest. Prometheus stores character stats, Loki stores map observations and quest interactions, and Tempo stores chapter traces. Use the time picker or zoom a chart to investigate part of a run.",
  "tags": [
    "wow",
    "simulation"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-27h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "run",
        "label": "Simulated run",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(wow_journey_level, run)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(wow_journey_level, run)",
        "refresh": 2,
        "sort": 4,
        "options": [],
        "current": {},
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "geomap",
      "title": "Tirisfal Glades · Traveled route",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 15,
        "h": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "forward",
          "maxLines": 1000,
          "expr": "{service_name=\"wow-journey-simulator\",service_instance_id=\"$run\"}",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "backward",
          "maxLines": 1,
          "expr": "{service_name=\"wow-journey-simulator\",service_instance_id=\"$run\"}",
          "editorMode": "code"
        }
      ],
      "options": {
        "basemap": {
          "type": "xyz",
          "name": "Zone coordinates",
          "noRepeat": true,
          "config": {
            "url": "/api/datasources/proxy/uid/wow-journey/api/journey/grid/tiles/{z}/{x}/{y}",
            "maxZoom": 4
          }
        },
        "layers": [
          {
            "type": "route",
            "name": "Traveled route",
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "location": {
              "mode": "coords",
              "latitude": "Latitude",
              "longitude": "Longitude"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#503625"
                },
                "size": {
                  "fixed": 6
                },
                "opacity": 1,
                "lineWidth": 3
              },
              "showLegend": false
            }
          },
          {
            "type": "route",
            "name": "Trail",
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "location": {
              "mode": "coords",
              "latitude": "Latitude",
              "longitude": "Longitude"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#ffdc83"
                },
                "size": {
                  "fixed": 3
                },
                "opacity": 1,
                "lineWidth": 3
              },
              "showLegend": false
            }
          },
          {
            "type": "markers",
            "name": "Current position",
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "location": {
              "mode": "coords",
              "latitude": "Latitude",
              "longitude": "Longitude"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#83e2e5"
                },
                "size": {
                  "fixed": 11
                },
                "opacity": 1,
                "lineWidth": 3
              },
              "showLegend": false
            }
          }
        ],
        "view": {
          "id": "coords",
          "lat": -6,
          "lon": -20,
          "zoom": 2.25
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        }
      },
      "description": "Each point comes from a timestamped Loki position log. Gold traces the selected time range. Blue marks its latest position.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "jsonPaths": [
              {
                "path": "latitude",
                "alias": "Latitude"
              },
              {
                "path": "longitude",
                "alias": "Longitude"
              },
              {
                "path": "place",
                "alias": "Place"
              },
              {
                "path": "minute",
                "alias": "Minute"
              },
              {
                "path": "x",
                "alias": "Map X (%)"
              },
              {
                "path": "y",
                "alias": "Map Y (%)"
              }
            ]
          }
        }
      ]
    },
    {
