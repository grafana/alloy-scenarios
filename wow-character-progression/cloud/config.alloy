// Send gameplay logs to Loki and native metrics and traces to the stack OTLP gateway.
// The companion writes one JSON Lines file per session. Credentials come from cloud/.env.

local.file_match "recordings" {
	path_targets = [{
		__path__     = coalesce(sys.env("ALLOYROUTE_EXPORT_GLOB"), "/exports/*.jsonl"),
		service_name = "wow-alloyroute",
	}]
	sync_period = "10s"
}

loki.source.file "recordings" {
	targets       = local.file_match.recordings.targets
	forward_to    = [loki.process.recordings.receiver]
	tail_from_end = false
}

loki.process "recordings" {
	stage.json {
		expressions = {
			ts_ns      = "",
			type       = "",
			session_id = "",
			region     = "",
			realm      = "",
			character  = "",
		}
	}

	// Order by gameplay time. seq separates rows within one second.
	stage.timestamp {
		source = "ts_ns"
		format = "UnixNs"
	}

	// A few low-cardinality stream labels identify the character.
	stage.labels {
		values = {
			region    = "",
			realm     = "",
			character = "",
		}
	}

	// Per-line details stay out of the index.
	stage.structured_metadata {
		values = {
			type       = "",
			session_id = "",
		}
	}

	stage.label_drop {
		values = ["filename"]
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("ALLOYROUTE_LOKI_TOKEN")
		}
	}

	external_labels = {
		source = "alloyroute-v2",
	}
}

otelcol.auth.basic "native" {
	username = sys.env("ALLOYROUTE_OTLP_USER")
	password = sys.env("ALLOYROUTE_OTLP_TOKEN")
}

otelcol.receiver.otlp "recordings" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.exporter.otlphttp.native.input]
		traces  = [otelcol.exporter.otlphttp.native.input]
	}
}

// A successful receiver response should follow the upstream export.
// The companion retains unacknowledged batches on disk and retries them.
otelcol.exporter.otlphttp "native" {
	client {
		endpoint = coalesce(sys.env("ALLOYROUTE_OTLP_ENDPOINT"), "http://127.0.0.1:1")
		auth     = otelcol.auth.basic.native.handler
	}

	sending_queue {
		enabled = false
	}

	retry_on_failure {
		enabled = false
	}
}
