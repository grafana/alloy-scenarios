# Copy to cloud/.env (git-ignored) and fill in, or let create_access_policy.py write it.
# Stack details page: Grafana Cloud portal, your stack, Loki, Details.
GRAFANA_CLOUD_LOKI_URL=https://logs-<cluster>.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=<numeric Loki user ID>
# An access policy token with the logs:write scope for this stack.
ALLOYROUTE_LOKI_TOKEN=
