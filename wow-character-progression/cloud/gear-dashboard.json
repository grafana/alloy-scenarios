{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "wow-character-gear"
  },
  "spec": {
    "title": "Azeroth Chronicle · Journey",
    "description": "Explore routes, fights, quests, loot and equipment in recorded character sessions.",
    "schemaVersion": 41,
    "timezone": "browser",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "tags": [
      "wow",
      "alloy-route"
    ],
    "templating": {
      "list": [
        {
          "name": "logs",
          "label": "Logs data source",
          "type": "datasource",
          "query": "loki",
          "current": {
            "text": "grafanacloud-logs",
            "value": "grafanacloud-logs"
          },
          "refresh": 1
        },
        {
          "name": "metrics",
          "label": "Metrics data source",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "text": "grafanacloud-prom",
            "value": "grafanacloud-prom"
          },
          "refresh": 1,
          "hide": 2
        },
        {
          "name": "traces",
          "label": "Trace data source",
          "type": "datasource",
          "query": "tempo",
          "current": {
            "text": "grafanacloud-traces",
            "value": "grafanacloud-traces"
          },
          "refresh": 1,
          "hide": 2
        },
        {
          "type": "query",
          "name": "region",
          "label": "Region",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "refresh": 1,
          "sort": 1,
          "query": {
            "type": 1,
            "label": "region",
            "stream": "{service_name=\"wow-alloyroute\"}"
          },
          "definition": "label_values({service_name=\"wow-alloyroute\"}, region)",
          "current": {}
        },
        {
          "type": "query",
          "name": "realm",
          "label": "Realm",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "refresh": 1,
          "sort": 1,
          "query": {
            "type": 1,
            "label": "realm",
            "stream": "{service_name=\"wow-alloyroute\",region=\"${region}\"}"
          },
          "definition": "label_values({service_name=\"wow-alloyroute\",region=\"${region}\"}, realm)",
          "current": {}
        },
        {
          "type": "query",
          "name": "character",
          "label": "Character",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "refresh": 1,
          "sort": 1,
          "query": {
            "type": 1,
            "label": "character",
            "stream": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\"}"
          },
          "definition": "label_values({service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\"}, character)",
          "current": {}
        },
        {
          "name": "session",
          "label": "Session ID (.* for all)",
          "type": "textbox",
          "query": ".*",
          "current": {
            "text": ".*",
            "value": ".*"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Total armour over time",
        "description": "Effective armour shown on the character sheet, including bonuses. Points are observations. Each recording is a separate series.",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 9
        },
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "decimals": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "stepAfter",
              "showPoints": "always",
              "pointSize": 6,
              "fillOpacity": 6
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${logs}"
            },
            "expr": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\",character=\"${character}\"} | type=\"armor\" | session_id=~\"${session:raw}\"",
            "queryType": "range",
            "direction": "forward",
            "maxLines": 5000
          }
        ],
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "body",
              "format": "json",
              "replace": true,
              "keepTime": false,
              "jsonPaths": [
                {
                  "path": "time",
                  "alias": "Time"
                },
                {
                  "path": "armor",
                  "alias": "Armour"
                },
                {
                  "path": "session_id",
                  "alias": "Session"
                }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                {
                  "targetField": "Time",
                  "destinationType": "time"
                },
                {
                  "targetField": "Armour",
                  "destinationType": "number"
                }
              ]
            }
          },
          {
            "id": "partitionByValues",
            "options": {
              "fields": [
                "Session"
              ],
              "keepFields": false
            }
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 2,
        "title": "Starting equipment",
        "description": "One row per equipment slot at the start of each recording. Choose a session or a time range that includes its start. Item ID 0 means empty.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 9,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${logs}"
            },
            "expr": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\",character=\"${character}\"} | type=\"gear_start\" | session_id=~\"${session:raw}\"",
            "queryType": "range",
            "direction": "forward",
            "maxLines": 5000
          }
        ],
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "body",
              "format": "json",
              "replace": true,
              "keepTime": false,
              "jsonPaths": [
                {
                  "path": "time",
                  "alias": "Time"
                },
                {
                  "path": "slot",
                  "alias": "Slot"
                },
                {
                  "path": "item_name",
                  "alias": "Equipped"
                },
                {
                  "path": "item_id",
                  "alias": "Item ID"
                },
                {
                  "path": "session_id",
                  "alias": "Session"
                }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                {
                  "targetField": "Time",
                  "destinationType": "time"
                }
              ]
            }
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Item ID",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 3,
        "title": "Equipment changes",
        "description": "Each equip, replacement or removal in game order. Empty means the slot was unoccupied.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 17,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${logs}"
            },
            "expr": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\",character=\"${character}\"} | type=\"gear_swap\" | session_id=~\"${session:raw}\"",
            "queryType": "range",
            "direction": "forward",
            "maxLines": 5000
          }
        ],
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "body",
              "format": "json",
              "replace": true,
              "keepTime": false,
              "jsonPaths": [
                {
                  "path": "time",
                  "alias": "Time"
                },
                {
                  "path": "slot",
                  "alias": "Slot"
                },
                {
                  "path": "previous_item_name",
                  "alias": "Previously equipped"
                },
                {
                  "path": "item_name",
                  "alias": "Now equipped"
                },
                {
                  "path": "previous_item_id",
                  "alias": "Previous ID"
                },
                {
                  "path": "item_id",
                  "alias": "New ID"
                },
                {
                  "path": "session_id",
                  "alias": "Session"
                }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                {
                  "targetField": "Time",
                  "destinationType": "time"
                }
              ]
            }
          }
        ],
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 4,
        "title": "Session traces",
        "description": "Open a session trace to inspect timestamped positions, equipment changes, quests and NPC interactions.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 25,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "tempo",
          "uid": "${traces}"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "tempo",
              "uid": "${traces}"
            },
            "queryType": "traceql",
            "tableType": "traces",
            "query": "{ resource.service.name = \"wow-alloyroute\" && resource.wow.region = \"$region\" && resource.wow.realm = \"$realm\" && resource.wow.character = \"$character\" && name = \"wow.session\" && span.wow.trace_schema = 2 && span.wow.session_id =~ \"${session:raw}\" }",
            "limit": 50
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Armour at export • Cloud Metrics",
        "description": "Native gauges for the complete session, stamped at export time. Use a time range including export to see them. The character filters apply to this panel.",
        "gridPos": {
          "x": 0,
          "y": 33,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "min": 0,
            "custom": {
              "drawStyle": "points",
              "showPoints": "always",
              "pointSize": 6
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${metrics}"
            },
            "expr": "wow_addon_checkpoint_armor{region=\"$region\", realm=\"$realm\", character=\"$character\"}",
            "legendFormat": "Final",
            "range": true,
            "editorMode": "code"
          },
          {
            "refId": "B",
            "datasource": {
              "type": "prometheus",
              "uid": "${metrics}"
            },
            "expr": "wow_addon_session_armor_start{region=\"$region\", realm=\"$realm\", character=\"$character\"}",
            "legendFormat": "Starting",
            "range": true,
            "editorMode": "code"
          },
          {
            "refId": "C",
            "datasource": {
              "type": "prometheus",
              "uid": "${metrics}"
            },
            "expr": "wow_addon_session_armor_min{region=\"$region\", realm=\"$realm\", character=\"$character\"}",
            "legendFormat": "Minimum",
            "range": true,
            "editorMode": "code"
          },
          {
            "refId": "D",
            "datasource": {
              "type": "prometheus",
              "uid": "${metrics}"
            },
            "expr": "wow_addon_session_armor_max{region=\"$region\", realm=\"$realm\", character=\"$character\"}",
            "legendFormat": "Maximum",
            "range": true,
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 6,
        "title": "Combat and quest journal",
        "description": "Combat boundaries, quest acceptances and hand-ins in gameplay order. Reward values are reported by the game on turn-in.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 41,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "fieldConfig": {
          "defaults": {
            "noValue": "—",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "Not Found": {
                    "text": "—"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${logs}"
            },
            "expr": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\",character=\"${character}\"} | type=~\"combat|quest_accepted|quest_turned_in\" | session_id=~\"${session:raw}\"",
            "queryType": "range",
            "direction": "forward",
            "maxLines": 5000
          }
        ],
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "body",
              "format": "json",
              "replace": true,
              "keepTime": false,
              "jsonPaths": [
                {
                  "path": "time",
                  "alias": "Time"
                },
                {
                  "path": "type",
                  "alias": "Event"
                },
                {
                  "path": "state",
                  "alias": "Combat state"
                },
                {
                  "path": "quest_title",
                  "alias": "Quest"
                },
                {
                  "path": "quest_id",
                  "alias": "Quest ID"
                },
                {
                  "path": "npc_name",
                  "alias": "NPC"
                },
                {
                  "path": "reward_xp",
                  "alias": "Reward XP"
                },
                {
                  "path": "reward_copper",
                  "alias": "Reward copper"
                },
                {
                  "path": "zone",
                  "alias": "Zone"
                }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                {
                  "targetField": "Time",
                  "destinationType": "time"
                }
              ]
            }
          }
        ],
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 7,
        "title": "Quest objectives and loot",
        "description": "Recorded observations at gameplay time. Blank cells indicate unavailable or inapplicable fields.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 49,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "fieldConfig": {
          "defaults": {
            "noValue": "—",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "Not Found": {
                    "text": "—"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${logs}"
            },
            "expr": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\",character=\"${character}\"} | type=~\"quest_objective|loot_received\" | session_id=~\"${session:raw}\"",
            "queryType": "range",
            "direction": "forward",
            "maxLines": 5000
          }
        ],
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "body",
              "format": "json",
              "replace": true,
              "keepTime": false,
              "jsonPaths": [
                {
                  "path": "time",
                  "alias": "Time"
                },
                {
                  "path": "type",
                  "alias": "Event"
                },
                {
                  "path": "quest_id",
                  "alias": "Quest ID"
                },
                {
                  "path": "objective",
                  "alias": "Objective"
                },
                {
                  "path": "observation",
                  "alias": "Reading"
                },
                {
                  "path": "fulfilled",
                  "alias": "Progress"
                },
                {
                  "path": "required",
                  "alias": "Required"
                },
                {
                  "path": "finished",
                  "alias": "Complete"
                },
                {
                  "path": "item_name",
                  "alias": "Item"
                },
                {
                  "path": "quantity",
                  "alias": "Quantity"
                }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                {
                  "targetField": "Time",
                  "destinationType": "time"
                }
              ]
            }
          }
        ],
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 8,
        "title": "Route and encounters",
        "description": "Recorded observations at gameplay time. Blank cells indicate unavailable or inapplicable fields.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 57,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "fieldConfig": {
          "defaults": {
            "noValue": "—",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "Not Found": {
                    "text": "—"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${logs}"
            },
            "expr": "{service_name=\"wow-alloyroute\",region=\"${region}\",realm=\"${realm}\",character=\"${character}\"} | type=~\"snapshot|subzone|target|life\" | session_id=~\"${session:raw}\"",
            "queryType": "range",
            "direction": "forward",
            "maxLines": 5000
          }
        ],
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "body",
              "format": "json",
              "replace": true,
              "keepTime": false,
              "jsonPaths": [
                {
                  "path": "time",
                  "alias": "Time"
                },
                {
                  "path": "type",
                  "alias": "Event"
                },
                {
                  "path": "zone",
                  "alias": "Zone"
                },
                {
                  "path": "subzone",
                  "alias": "Subzone"
                },
                {
                  "path": "map_id",
                  "alias": "Map"
                },
                {
                  "path": "x",
                  "alias": "Map X (×0.01%)"
                },
                {
                  "path": "y",
                  "alias": "Map Y (×0.01%)"
                },
                {
                  "path": "npc_name",
                  "alias": "Target"
                },
                {
                  "path": "state",
                  "alias": "Life state"
                }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                {
                  "targetField": "Time",
                  "destinationType": "time"
                }
              ]
            }
          }
        ],
        "options": {
          "showHeader": true
        }
      }
    ]
  }
}
